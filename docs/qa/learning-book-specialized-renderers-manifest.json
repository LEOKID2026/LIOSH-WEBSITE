      "tests": ["tests/e2e/learning-book-g2-bidi-route.spec.ts"],
      "screenshots": [
        "docs/qa/rtl-route-regression-screenshots/g2-add_two-section-3-exact-block.png",
        "docs/qa/rtl-route-regression-screenshots/g2-sub_two-section-3-exact-block.png"
