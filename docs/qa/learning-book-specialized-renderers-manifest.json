      "screenshots": ["docs/qa/rtl-route-regression-screenshots/g2-ns_place_tens_units-section-3.png"]
    },
    {
      "renderer": "FrameDiagram",
      "status": "certified specialized renderer",
      "routes": [
        "/learning/book/math/g2/ns_complement10#section-3",
        "/learning/book/math/g1/ns_complement10#section-3"
      ],
      "contract": "Frame border rows remain LTR; rows containing Hebrew are routed through MixedDiagramLine / BookContentLine / MixedHebrewMathText so prose never enters a full-row LTR island.",
      "tests": [
        "tests/e2e/learning-book-g2-bidi-route.spec.ts",
        "scripts/qa/scan-learning-book-g2-route-bidi.mjs"
      ],
      "screenshots": ["docs/qa/rtl-route-regression-screenshots/g2-ns_complement10-section-3-frame.png"]
    },
    {
      "renderer": "object/card/coin visual rows",
      "status": "certified specialized renderer",
      "routes": [
        "/learning/book/math/g2/mul#section-3",
        "/learning/book/math/g2/wp_groups_g2#section-3",
